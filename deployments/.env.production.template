# AVAR Production Environment Template
# Copy this file to .env.production and fill in the values
# NEVER commit the actual .env.production file to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Generate a secure password: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DATABASE_URL=postgresql+asyncpg://avar:${DB_PASSWORD}@localhost:5432/avar_db

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
SECRET_KEY=${JWT_SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# REDIS CONFIGURATION
# ============================================
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# ============================================
# SERVICE URLS
# ============================================
AI_DETECTION_SERVICE_URL=http://localhost:8001
VITE_API_BASE_URL=https://avar.studio/api/v1

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
UPLOAD_DIR=/var/www/avar/src/backend/competition-service/uploads
MAX_UPLOAD_SIZE_MB=200

# ============================================
# THIRD-PARTY API KEYS (Optional - for AI detection)
# ============================================
# Get from: https://sightengine.com
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Get from: https://thehive.ai
HIVE_AI_API_KEY=

# Get from: https://optic.xyz
OPTIC_API_KEY=

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://avar.studio,https://www.avar.studio

# ============================================
# SSL CONFIGURATION
# ============================================
# Set to true if you have a domain and want HTTPS
ENABLE_SSL=true
DOMAIN=avar.studio

# ============================================
# MONITORING (Optional)
# ============================================
# Prometheus metrics endpoint
ENABLE_METRICS=false
METRICS_PORT=9090
