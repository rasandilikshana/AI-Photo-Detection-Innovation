# Production Environment Configuration
# API Gateway URL (Update with production URL)
VITE_API_URL=https://api.avar.example.com

# AI Detection Service URL (Update with production URL)
VITE_AI_DETECTION_URL=https://ai.avar.example.com

# Application Settings
VITE_APP_NAME=A.V.A.R
VITE_APP_TITLE=Authentic Visual Art Recognition Platform
VITE_APP_ENV=production

# File Upload Settings
VITE_MAX_FILE_SIZE_MB=50
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg
VITE_ALLOWED_RAW_TYPES=.cr2,.nef,.arw,.dng,.raf

# Debugging
VITE_DEBUG=false
