# Competition Service Configuration

# Service
SERVICE_NAME=competition-service
SERVICE_PORT=8080
SERVICE_HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://avar_user:avar_password@localhost:5432/avar_competitions
DATABASE_ECHO=True

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Gateway
AI_DETECTION_SERVICE_URL=http://localhost:8001
API_GATEWAY_URL=http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,tiff,raw,cr2,nef,arw,dng

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@avar.com

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
