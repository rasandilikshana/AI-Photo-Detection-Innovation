# Database Configuration
DB_PASSWORD=your_secure_password_here

# AI Detection API Keys (Layer 3)
# Hive AI: Get your API key from https://thehive.ai/
# Format: "access_key_id:secret_key" (e.g., "HjdGqc6r:ZVcmY3SI==")
HIVE_AI_API_KEY=your_access_key:your_secret_key
OPTIC_API_KEY=your_optic_api_key_here

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# File Upload Limits
MAX_FILE_SIZE=100M
MAX_RAW_SIZE=200M

# Redis Configuration
REDIS_PASSWORD=

# Email Configuration (for notifications)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@avar.local
MAIL_FROM_NAME="AVAR System"
